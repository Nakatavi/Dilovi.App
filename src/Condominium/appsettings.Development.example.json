{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=condominium;Username=admin;Password=<POSTGRES_PASSWORD>"
  },
  "MiddlewareSettings": {
    "EnableDatabaseLogging": false
  },
  "JwtSettings": {
    "SecretKey": "<at least 32 characters, keep it in user-secrets>",
    "Issuer": "Condominium",
    "Audience": "Condominium.Client",
    "ExpiryMinutes": 60
  }
}
